body {
    background-color: #87CEFA;
    font-family: "Times New Roman", serif;
    color: #808080;
}

.kartu-profil {
    width: 300px;
    margin: 50px auto;
    padding: 20px;
    background-color: white;
    border-radius: 15px;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
    text-align: center;
}

.kartu-profil img {
    width: 150px;
    height: 150px;
    object-fit: cover;
    border-radius: 50%;
}

.kartu-profil h1 {
    color: #333333;
    font-size: 24px;
}

.kartu-profil p {
    line-height: 1.5;
}

.kartu-profil a {
    color: #0077cc;
    text-decoration: none;
}

.kartu-profil a:hover {
    text-decoration: underline;
}

.kartu-profil button {
    padding: 10px 20px;
    background-color: #0077cc;
    color: white;
    border: none;
    border-radius: 8px;
    cursor: pointer;
}

.kartu-profil button:hover {
    background-color: #005fa3;
}
